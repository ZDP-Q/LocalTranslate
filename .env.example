# Environment variables for AI Translation System
# Copy this file to .env and modify as needed

# ============ UV Package Manager ============
# Fix Windows hardlink warning - use copy mode instead of hardlink
UV_LINK_MODE=copy

# ============ Application ============
TRANSLATOR_DEBUG=false

# ============ Model Settings ============
TRANSLATOR_MODEL_NAME=tencent/HY-MT1.5-1.8B
TRANSLATOR_MODEL_USE_BFLOAT16=true
TRANSLATOR_MODEL_MAX_NEW_TOKENS=2048
TRANSLATOR_MODEL_DEVICE_MAP=auto

# ============ Logging ============
TRANSLATOR_LOG_LEVEL=INFO
# TRANSLATOR_LOG_FILE=logs/translator.log
TRANSLATOR_LOG_JSON_OUTPUT=false

# ============ GUI ============
TRANSLATOR_GUI_THEME=dark
TRANSLATOR_GUI_WINDOW_WIDTH=1100
TRANSLATOR_GUI_WINDOW_HEIGHT=800
